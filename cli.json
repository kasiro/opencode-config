{
  "$schema": "https://opencode.ai/v2/cli.json",
  "plugins": [
    "@prevalentware/opencode-goal-plugin"
  ],
  "diffs": {
    "wrap": "word"
  },
  "session": {
    "sidebar": "auto",
    "scrollbar": true,
    "thinking": "show",
    "image_preview": true,
    "permissions": "autoaccept"
  },
  "animations": true,
  "theme": {
    "mode": "system"
  }
}
