{
  "$schema": "https://opencode.ai/v2/cli.json",
  "plugins": [
    "@prevalentware/opencode-goal-plugin"
  ],
  "diffs": {
    "wrap": "word",
    "view": "auto",
    "single": false
  },
  "session": {
    "sidebar": "auto",
    "scrollbar": true,
    "thinking": "show",
    "image_preview": true,
    "permissions": "autoaccept",
    "markdown": "rendered",
    "grouping": "none",
    "verbosity": "high"
  },
  "animations": true,
  "theme": {
    "mode": "system"
  },
  "terminal": {
    "copy": "select"
  },
  "attention": {
    "volume": 0.4,
    "sound": true,
    "notifications": true
  },
  "prompt": {
    "image_preview": true,
    "paste": "compact"
  },
  "scroll": {
    "acceleration": true,
    "speed": 2
  },
  "tabs": {
    "layout": "horizontal",
    "indicators": "status",
    "mode": "on"
  },
  "mini": {
    "tools": "show",
    "thinking": "show",
    "shell_output": "show",
    "turn_summary": "show",
    "footer": "show",
    "mono": false,
    "work_spinner": "block-bridge"
  }
}
