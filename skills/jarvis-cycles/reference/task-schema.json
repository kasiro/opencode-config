{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "jarvis-task-schema",
  "title": "Structured Task Format",
  "description": "Формат задачи J.A.R.V.I.S. — парсинг задачи сэра в структурированное представление",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "description": "Автоматически генерируемый ID задачи"
    },
    "statement": {
      "type": "string",
      "description": "Оригинальная формулировка задачи от сэра"
    },
    "type": {
      "type": "string",
      "enum": ["research", "code", "hybrid", "system", "verify", "learn"],
      "description": "Тип задачи"
    },
    "complexity": {
      "type": "string",
      "enum": ["simple", "medium", "complex"],
      "description": "simple=1-2 шага, medium=3-5, complex=6+"
    },
    "constraints": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Ограничения из контекста: технологии, ОС, платформа"
    },
    "domain": {
      "type": "string",
      "description": "Предметная область: MCP, frontend, backend, devops, docs, general"
    },
    "success_criteria": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Конкретные критерии успеха — что должно быть сделано"
    },
    "verification": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Методы проверки успеха: build, test, curl, bash, lint"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Уверенность в понимании задачи: 0.0-1.0"
    },
    "steps": {
      "type": "array",
      "description": "Декомпозированные подзадачи (заполняется на шаге Decompose)",
      "items": {
        "type": "object",
        "properties": {
          "step_id": { "type": "string" },
          "type": { 
            "type": "string", 
            "enum": ["research", "code", "verify", "system", "learn"]
          },
          "agent": {
            "type": "string",
            "enum": ["researcher", "executor", "general", "sysadmin", "self"]
          },
          "description": { "type": "string" },
          "depends_on": {
            "type": "array",
            "items": { "type": "string" }
          },
          "success_criteria": { "type": "string" },
          "verification": { "type": "string" }
        },
        "required": ["step_id", "type", "agent", "description"]
      }
    }
  },
  "required": ["id", "statement", "type", "complexity", "confidence"]
}
