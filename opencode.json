{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "localproxy": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "localproxy.odirouter.ai",
      "options": {
        "baseURL": "http://localhost:9625/v1"
      },
      "models": {
        "free-minimax-m2.7": {
            "name": "free-minimax-m2.7"
        },
        "free-gemini-2.5-pro": {
            "name": "free-gemini-2.5-pro"
        },
        "free-minimax-m2.7": {
            "name": "free-minimax-m2.7"
        },
        "free-claude-haiku-4-5-20251001": {
            "name": "free-claude-haiku-4-5-20251001"
        },
        "free-gemini-2.5-flash": {
            "name": "free-gemini-2.5-flash"
        },
        "free-qwen3.5-plus": {
            "name": "free-qwen3.5-plus"
        },
        "free-qwen3.5-flash": {
            "name": "free-qwen3.5-flash"
        },
        "free-minimax-m2.5": {
            "name": "free-minimax-m2.5"
        },
        "free-gemini-2.5-flash-lite": {
            "name": "free-gemini-2.5-flash-lite"
        },
        "free-gemini-3-flash-preview": {
            "name": "free-gemini-3-flash-preview"
        }
      }
    }
  },
  "default_agent": "jarvis",
  "subagent_depth": 2,
  "share": "disabled",
  "instructions": [
    "~/.config/opencode/global-rules.md"
  ],
  "permission": {
    "bash": {
      "*find*": "deny",
      "*grep*": "deny",
      "*npm*": "deny",
      "*sqlite*": "ask",
      "*opencode*": "ask"
    },
    "glob": "deny",
    "grep": "deny",
    "websearch": "deny"
  },
  "mcp": {
    "deepwiki": {
      "type": "remote",
      "url": "https://mcp.deepwiki.com/mcp",
      "enabled": true,
      "timeout": 120000
    },
    "sequential-thinking": {
      "type": "local",
      "command": [
        "/home/kasiro/.bun/bin/mcp-server-sequential-thinking"
      ],
      "timeout": 120000,
      "enabled": true
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true,
      "timeout": 120000,
      "headers": {
        "Authorization": "Bearer ctx7sk-418a5f6a-2b9c-4caa-94e2-573821193500"
      }
    },
    "youtube-transcript": {
      "type": "local",
      "command": [
        "/home/kasiro/Документы/python_projects/yt-transcript-mcp/.venv/bin/yt-transcript-mcp"
      ],
      "environment": {
        "EXA_API_KEY": "57c7932c-0ffa-4f75-8173-da5b8a343752"
      },
      "timeout": 60000,
      "enabled": false
    },
    "lightpanda": {
      "type": "local",
      "command": [
        "lightpanda",
        "mcp"
      ],
      "enabled": true,
      "timeout": 60000,
      "environment": {
        "LIGHTPANDA_DISABLE_TELEMETRY": "true"
      },
      "description": "Lightpanda headless browser — быстрый MCP скрапинг"
    },
    "deploychan": {
      "type": "remote",
      "url": "https://mcp.deploychan.webcam/mcp",
      "enabled": true,
      "timeout": 120000
    }
  },
  "agent": {
    "jarvis": {
      "permission": {
        "edit": {
          "*": "deny"
        },
        "bash": {
          "*": "deny"
        },
        "websearch": "deny",
        "webfetch": "deny",
        "deepwiki_*": "deny",
        "context7_*": "deny",
        "youtube-transcript_*": "deny",
        "lightpanda_*": "deny"
      }
    },
    "title": {
      "model": "opencode/big-pickle"
    },
    "general": {
      "permission": {
        "edit": {
          "*": "allow"
        },
        "bash": {
          "*": "allow",
          "*grep*": "deny",
          "*find*": "deny",
          "*npx*": "deny",
          "*npm*": "deny",
          "*sqlite*": "ask"
        },
        "websearch": "deny",
        "webfetch": "deny",
        "skill": {
          "agent-delegation": "deny",
          "jarvis-cycles": "deny"
        }
      },
      "tools": {
        "glob": false,
        "grep": false,
        "sequential-thinking_*": true,
        "deepwiki_*": true,
        "context7_*": true,
        "youtube-transcript_*": true,
        "lightpanda_*": true,
        "memory_set": false,
        "memory_replace": false,
        "memory_list": false
      }
    },
    "explore": {
      "disable": true
    }
  },
  "lsp": {},
  "plugin": [
    "opencode-intellisearch",
    "@tarquinen/opencode-dcp@3.1.13",
    "opencode-agent-memory"
  ],
  "compaction": {
    "auto": false,
    "prune": false
  },
  "tool_output": {
    "max_lines": 5000,
    "max_bytes": 204800
  },
  "experimental": {
    "mcp_timeout": 120000
  }
}
