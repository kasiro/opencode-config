  "default_agent": "jarvis",
  "instructions": [
    "~/.config/opencode/global-rules.md"
  ],
  "share": "disabled",
  "permissions": [
    {
      "action": "tool.use",
      "resource": "bash:*find*",
      "effect": "deny"
    },
    {
      "action": "tool.use",
      "resource": "bash:*grep*",
      "effect": "deny"
    },
    {
      "action": "tool.use",
      "resource": "bash:*npm*",
      "effect": "deny"
    },
    {
      "action": "tool.use",
      "resource": "bash:*sqlite*",
      "effect": "ask"
    },
    {
      "action": "tool.use",
      "resource": "bash:*opencode*",
      "effect": "ask"
    },
    {
      "action": "tool.use",
      "resource": "glob",
      "effect": "deny"
    },
    {
      "action": "tool.use",
      "resource": "grep",
      "effect": "deny"
    },
    {
      "action": "websearch.use",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "tool.use",
      "resource": "webfetch",
      "effect": "deny"
    }
  ],
  "mcp": {
    "deepwiki": {
      "type": "remote",
      "enabled": true,
      "url": "https://mcp.deepwiki.com/mcp",
      "timeout": 120000
    },
    "sequential-thinking": {
      "type": "local",
      "enabled": true,
      "command": [
        "/home/kasiro/.npm-global/bin/mcp-server-sequential-thinking"
      ],
      "timeout": 120000
    },
    "context7": {
      "type": "remote",
      "enabled": true,
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "Authorization": "Bearer ctx7sk-418a5f6a-2b9c-4caa-94e2-573821193500"
      },
      "timeout": 120000
    },
    "lightpanda": {
      "type": "local",
      "enabled": true,
      "command": [
        "/home/kasiro/.npm-global/bin/lightpanda-mcp"
      ],
      "environment": {
        "LIGHTPANDA_DISABLE_TELEMETRY": "true"
      },
      "description": "Lightpanda headless browser — быстрый MCP скрапинг",
      "timeout": 60000
    },
    "deploychan": {
      "type": "remote",
      "enabled": true,
      "url": "https://mcp.deploychan.webcam/mcp",
      "timeout": 120000
    }
  },
  "agents": {
    "jarvis": {
      "permissions": [
