{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/deepseek-v4-flash-free",
  "default_agent": "jarvis",
  "share": "disabled",
  "instructions": [
    "~/.config/opencode/global-rules.md",
    "~/.config/opencode/persona/soul.md"
  ],
  "permission": {
    "bash": {
      "*find*": "deny",
      "*grep*": "deny",
      "*npm*": "deny",
      "*sqlite*": "ask",
      "*opencode*": "ask"
    },
    "glob": "deny",
    "grep": "deny",
    "websearch": "deny"
  },
  "mcp": {
    "exa": {
      "type": "remote",
      "url": "http://127.0.0.1:18099",
      "enabled": true,
      "timeout": 120000
    },
    "deepwiki": {
      "type": "remote",
      "url": "https://mcp.deepwiki.com/mcp",
      "enabled": true,
      "timeout": 120000
    },
    "sequential-thinking": {
      "type": "local",
      "command": [
        "/home/kasiro/.bun/bin/mcp-server-sequential-thinking"
      ],
      "timeout": 120000,
      "enabled": true
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true,
      "timeout": 120000,
      "headers": {
        "Authorization": "Bearer ctx7sk-418a5f6a-2b9c-4caa-94e2-573821193500"
      }
    },
    "web-research": {
      "type": "local",
      "command": [
        "bunx",
        "web-research-mcp"
      ],
      "enabled": true,
      "description": "Поиск через DuckDuckGo + fetch страниц"
    },
    "searxng": {
      "type": "local",
      "command": [
        "mcp-searxng"
      ],
      "enabled": true,
      "timeout": 60000,
      "environment": {
        "SEARXNG_URL": "http://localhost:8099",
        "SEARXNG_MAX_RESULTS": "15"
      },
      "description": "Поиск через свой SearXNG (Docker) + web_url_read"
    },
    "crawl4ai": {
      "type": "local",
      "command": [
        "uv",
        "run",
        "--directory",
        "/home/kasiro/Документы/python_projects/crawl4ai-mcp",
        "python",
        "-m",
        "crawl4ai_mcp.server"
      ],
      "timeout": 60000,
      "enabled": true,
      "description": "Crawl4AI MCP — краулинг, извлечение данных, sitemap, browser sessions"
    },
    "youtube-transcript": {
      "type": "local",
      "command": [
        "/home/kasiro/Документы/python_projects/yt-transcript-mcp/.venv/bin/yt-transcript-mcp"
      ],
      "environment": {
        "EXA_API_KEY": "57c7932c-0ffa-4f75-8173-da5b8a343752"
      },
      "timeout": 60000,
      "enabled": true
    },
    "memory": {
      "type": "local",
      "command": [
        "bun",
        "run",
        "--cwd",
        "/home/kasiro/.config/opencode/mcp-servers/memory-mcp",
        "src/index.ts"
      ],
      "enabled": true,
      "timeout": 30000
    }
  },
  "agent": {
    "jarvis": {
      "permission": {
        "edit": {
          "*": "deny"
        },
        "bash": {
          "*": "deny"
        },
        "websearch": "deny",
        "webfetch": "deny",
        "searxng_*": "deny",
        "crawl4ai_*": "deny",
        "deepwiki_*": "deny",
        "context7_*": "deny",
        "exa_*": "deny",
        "web-research_*": "deny",
        "youtube-transcript_*": "deny",
        "memory_*": "allow"
      }
    },
    "title": {
      "model": "opencode/big-pickle"
    },
    "general": {
      "permission": {
        "edit": {
          "**/memory/**": "deny",
          "*": "allow"
        },
        "bash": {
          "*sqlite*": "ask",
          "*": "allow"
        },
        "websearch": "allow",
        "webfetch": "allow",
        "skill": {
          "agent-delegation": "deny",
          "jarvis-cycles": "deny",
          "context-mgmt": "deny",
          "how_use_memory": "deny"
        },
        "memory_*": "deny"
      },
      "tools": {
        "sequential-thinking_*": true,
        "searxng_*": true,
        "deepwiki_*": true,
        "context7_*": true,
        "exa_*": true,
        "web-research_*": true,
        "crawl4ai_*": true,
        "youtube-transcript_*": true
      }
    },
    "memory-agent": {
      "permission": {
        "edit": {
          "**/memory/projects/**": "allow",
          "**/memory/global/**": "allow",
          "**/memory/sessions/**": "allow",
          "*": "deny"
        },
        "read": {
          "**/memory/**": "allow",
          "*": "deny"
        },
        "bash": {
          "*": "allow"
        },
        "websearch": "deny",
        "webfetch": "deny",
        "memory_*": "allow",
        "skill": "allow"
      },
      "tools": {
        "memory_*": true
      }
    }
  },
  "lsp": {},
  "plugin": [
    "@prevalentware/opencode-goal-plugin",
    "opencode-intellisearch",
    "@tarquinen/opencode-dcp@3.1.13"
  ],
  "compaction": {
    "auto": false,
    "prune": false
  },
  "tool_output": {
    "max_lines": 5000,
    "max_bytes": 204800
  },
  "experimental": {
    "mcp_timeout": 120000
  }
}
