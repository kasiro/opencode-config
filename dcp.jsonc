{
  "$schema": "https://raw.githubusercontent.com/Opencode-DCP/opencode-dynamic-context-pruning/master/dcp.schema.json",
  "enabled": true,
  "autoUpdate": false,
  "debug": true,
  "pruneNotification": "minimal",
  "pruneNotificationType": "chat",
  "turnProtection": {
    "enabled": false,
    "turns": 4
  },
  "compress": {
    "mode": "range",
    "permission": "allow",
    "showCompression": true,
    "summaryBuffer": false,
    "maxContextLimit": "80%",
    "minContextLimit": "40%",
    "nudgeFrequency": 1,
    "nudgeForce": "strong",
    "protectedTools": ["task", "skill", "todowrite", "todoread"],
    "protectTags": false,
    "protectUserMessages": true
  },
  "strategies": {
    "deduplication": {
      "enabled": true
    },
    "purgeErrors": {
      "enabled": true,
      "turns": 6
    }
  },
  "experimental": {
    "allowSubAgents": false
  }
}
